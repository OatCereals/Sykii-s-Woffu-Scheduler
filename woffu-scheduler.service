[Unit]
Description=kinkyscheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=woffu
WorkingDirectory=/home/woffu/woffu-scheduler
# .env: WOFFU_PORT=40, REGISTER_CODE=..., SECRET_KEY=...
EnvironmentFile=-/home/woffu/woffu-scheduler/.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/home/woffu/woffu-scheduler/venv/bin/python app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
